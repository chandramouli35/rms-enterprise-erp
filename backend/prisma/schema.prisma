model ProductionBatchStackInput {
  id                String          @id @default(uuid())
  productionBatchId String
  batch             ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  stackNo        String
  bags           Float?
  isDirectUnload Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionBatchId])
}

model HoodiRecord {
  id         String   @id @default(uuid())
  plantId    String
  date       DateTime @default(now())
  sourceType String // 'DIRECT_INWARD' | 'STACK_TRANSFER' | 'PART_INWARD'

  gpNo         String?
  mandiGpNo    String?
  truckNo      String?
  supplierName String?
  mandiName    String?
  stackNo      String?
  moisture     Float?
  bags         Float?
  unloadedBy   String?
  /** Stack↔Paddy integration — weighbridge weights + RST + fingerprint (Feedback 47) */
  grossWeight  Float?
  tareWeight   Float?
  netWeight    Float?
  rstNo        String?
  biometricData String?

  /** Cross-ref part unload (other point of same truck) */
  partStackNo    String? // stack no, or null when other part is also hoodi
  partIsHoodi    Boolean? @default(false)
  partBags       Float?
  partUnloader   String?
  partWeight     Float?

  inwardId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Dryer Bharai → Stack (dried paddy returned to paddy stack) */
model DryerBharaiToStack {
  id            String   @id @default(uuid())
  plantId       String
  date          DateTime @default(now())
  stackNo       String
  bags          Float
  moisture      Float?
  truckNo       String?
  grossWeight   Float?
  tareWeight    Float?
  netWeight     Float? // weighbridge Weight Segment (same unit as stack inventory)
  rstNo         String?
  biometricData String?
  verifiedById  String?
  unloadedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId, stackNo])
  @@index([plantId, date])
}

model PaddyStack {
  id              String  @id @default(uuid())
  plantId         String
  stackNo         String
  status          String  @default("ACTIVE") // ACTIVE, EMPTY, COMPLETED
  totalBags       Float   @default(0)
  totalWeight     Float   @default(0)
  averageMoisture Float   @default(0)
  bagsAClass      Float   @default(0)
  bagsBClass      Float   @default(0)
  isNewAClass     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, stackNo])
  @@index([plantId])
}

model PlantDowntime {
  id             String    @id @default(uuid())
  plantId        String
  plant          Plant     @relation(fields: [plantId], references: [id])
  date           DateTime
  shift          String // Day, Night
  supervisorName String?
  startTime      DateTime?
  endTime        DateTime?
  durationHours  Float?
  remarks        String?
  status         String    @default("COMPLETED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([date])
}
model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ALERT
  userId    String?  // If targeted at a specific user
  role      String?  // If targeted at a role (e.g., ADMIN)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Feedback 34 — evening / submitted daily shortage consolidated snapshot
model DailyShortageSnapshot {
  id          String   @id @default(uuid())
  reportDate  String   // YYYY-MM-DD
  plantId     String   @default("global") // real plant uuid or "global"
  payload     Json
  submittedBy String?
  source      String   @default("MANUAL") // MANUAL | EVENING_GP_FINALIZE | CRON
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reportDate, plantId])
  @@index([reportDate])
}

/// Feedback 35 — evening submitted Govt + Mill inward lists + daily summary snapshot
model DailyInwardListSnapshot {
  id          String   @id @default(uuid())
  reportDate  String   // YYYY-MM-DD
  plantId     String   // real plant uuid or "global"
  payload     Json     // { govt, mill, summary, bagWt, clusters }
  submittedBy String?
  biometricOk Boolean  @default(false)
  source      String   @default("MANUAL") // MANUAL | EVENING_SUBMIT | EVENING_GP_FINALIZE
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reportDate, plantId])
  @@index([reportDate])
}

/// Feedback 39 — per-unloader daily report submitted to Admin (before evening inward submit)
model DailyUnloaderReportSnapshot {
  id                   String   @id @default(uuid())
  reportDate           String   // YYYY-MM-DD
  plantId              String
  unloaderName         String
  payload              Json     // that unloader's day sheet
  unloaderSignedBy     String?
  supervisorSignedBy   String?
  unloaderBiometricOk  Boolean  @default(false)
  supervisorBiometricOk Boolean @default(false)
  submittedBy          String?
  submittedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([reportDate, plantId, unloaderName])
  @@index([reportDate, plantId])
}

// -----------------------------------------------------------------------------
// Stock Health Report (Yield Management)
// -----------------------------------------------------------------------------
model StockHealthConfig {
  id          String   @id @default(uuid())
  plantId     String   @unique
  plant       Plant    @relation(fields: [plantId], references: [id])
  totalWork   Float    // Total Work (A) in consignments — set by admin
  seasonLabel String?
  setBy       String?
  setAt       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Transfer Entry Management (Tickets)
// -----------------------------------------------------------------------------
model TransferTicket {
  id               String   @id @default(uuid())
  dispatchPlantId  String
  recipientPlantId String
  deliveryAtId     String?
  deliveryAtName   String
  status           String   @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION, CLOSED, ESCALATED
  
  originalGpId     String   @unique
  autoGpInId       String?  @unique
  autoGpOutId      String?  @unique
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  dispatchPlant    Plant    @relation("TransferDispatch", fields: [dispatchPlantId], references: [id])
  recipientPlant   Plant    @relation("TransferRecipient", fields: [recipientPlantId], references: [id])
  
  originalGp       GatePass @relation("OriginalGp", fields: [originalGpId], references: [id])
  autoGpIn         GatePass? @relation("AutoGpIn", fields: [autoGpInId], references: [id])
  autoGpOut        GatePass? @relation("AutoGpOut", fields: [autoGpOutId], references: [id])

  @@index([dispatchPlantId])
  @@index([recipientPlantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Mill Yield Benchmarks (Feedback 03) — mill-wise (per plant)
// -----------------------------------------------------------------------------
model MillYieldBenchmark {
  id              String   @id @default(uuid())
  /// Mill-wise benchmarks — required in app (API), nullable in DB so prisma push / legacy rows don't force data reset
  plantId         String?
  plant           Plant?   @relation(fields: [plantId], references: [id])
  itemKey         String // e.g. NET_RICE, KANI, NAKKU, TARGETS
  itemLabel       String
  requiredQty     Float?
  yieldPctPaddy   Float    // Yield % as per paddy
  yieldPctRice    Float    // Yield % as per rice (raw)
  roundFigRicePct Float    // Round Fig yield % of rice
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, itemKey])
  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Consignment Dispatch Details (Feedback 19)
// -----------------------------------------------------------------------------
model ConsignmentDispatch {
  id              String   @id @default(uuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id])
  date            DateTime
  isNilDay        Boolean  @default(false) // "Today No Consignment dispatch"
  gatePassId      String?
  gatePass        GatePass? @relation(fields: [gatePassId], references: [id])
  /// Comma-separated additional GatePass IDs (multi FCI / trucks in one entry — Feedback 19)
  extraGatePassIds String?
  fciGpNo         String?
  consignmentNo   String?
  mainBags        Float    @default(0)
  shortageBags    Float    @default(0)
  fciMoisture     Float?
  fciDamage       Float?
  fciDiscolour    Float?
  fciBroken       Float?
  fciDepoWeight   Float?
  fciPortalWeight Float?
  netWeightMill   Float?
  biometricData   String?
  submittedBy     String?
  submittedAt     DateTime?
  // Transfer rule (Feedback 21): only recipient mill creates consignment for transfer GPs
  fromTransferTicket Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([plantId, date])
  @@index([consignmentNo])
  @@index([gatePassId])
}

// -----------------------------------------------------------------------------
// Paddy Usage (Feedback 17 — yield as per paddy popup)
// -----------------------------------------------------------------------------
model PaddyUsageRecord {
  id              String   @id @default(uuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id])
  weekStart       DateTime
  weekEnd         DateTime
  openingStock    Float    @default(0)
  stockInHand     Float    @default(0)
  paddyDispatched Float    @default(0)
  paddyInHoodi    Float    @default(0)
  paddyInDryer    Float    @default(0)
  paddyInSilos    Float    @default(0)
  totalUsed       Float    @default(0)
  biometricData   String?
  submittedBy     String?
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, weekStart])
  @@index([plantId])
}
