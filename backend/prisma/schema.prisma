  productId  String
  product    Product        @relation("IntermillOutputProduct", fields: [productId], references: [id])
  outputBags Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([batchId])
}

model BatchAnalysis {
