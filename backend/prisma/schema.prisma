generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Plant {
  id          String    @id @default(uuid())
  name        String
  location    String?
  code        String    @unique // e.g., 'PLANT-A'
  
  // Relations
  users        UserPlantAccess[]
  procurements ProcurementBatch[]
  stockItems   InventoryItem[]
  suppliers    Supplier[]
  gatePasses   GatePass[]
  batches      Batch[]
  sourceTransfers PlantTransfer[] @relation("SourceTransfers")
  targetTransfers PlantTransfer[] @relation("TargetTransfers")
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([code])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., 'SUPER_ADMIN', 'PLANT_MANAGER', 'WEIGHBRIDGE_OPERATOR', 'ACCOUNTANT'
  description String?
  
  // Relations
  users       User[]
  permissions RolePermission[]
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id          String    @id @default(uuid())
  action      String    @unique // e.g., 'read:plants', 'create:users'
  description String?
  
  // Relations
  roles       RolePermission[]

  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model RolePermission {
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  refreshToken String?
  
  // Relations
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  plantAccess  UserPlantAccess[]

  // Tracking
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([username])
  @@index([email])
  @@index([roleId])
}

model UserPlantAccess {
  userId  String
  plantId String
  
  user    User  @relation(fields: [userId], references: [id])
  plant   Plant @relation(fields: [plantId], references: [id])

  @@id([userId, plantId])
  @@index([userId])
  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Procurement & Inventory
// -----------------------------------------------------------------------------

model Supplier {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  
  plantId     String
  plant       Plant     @relation(fields: [plantId], references: [id])
  
  gatePasses  GatePass[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([plantId])
}

model GatePass {
  id              String    @id @default(uuid())
  passNumber      String    @unique // e.g., GP-YYYYMMDD-XXXX
  vehicleNumber   String
  driverName      String?
  driverLicense   String?
  source          String    // FARMER, MANDI, VENDOR
  
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  
  estimatedBags   Int?
  status          String    @default("GENERATED") // GENERATED, GROSS_WEIGHED, QC_PASSED, TARE_WEIGHED, COMPLETED, REJECTED
  
  plantId         String
  plant           Plant     @relation(fields: [plantId], references: [id])
  createdByUserId String
  
  qualityCheck    QualityCheck?
  weighbridge     WeighbridgeTransaction?
  procurement     ProcurementBatch?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([plantId])
}

model QualityCheck {
  id                      String    @id @default(uuid())
  gatePassId              String    @unique
  gatePass                GatePass  @relation(fields: [gatePassId], references: [id])
  
  moisturePercentage      Float
  discolorationPercentage Float
  brokenGrainsPercentage  Float
  foreignMatterPercentage Float
  
  status                  String    @default("PENDING") // APPROVED, REJECTED, ACCEPTED_WITH_DEDUCTION
  priceDeductionPerMT     Float     @default(0)
  
  inspectorId             String
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model WeighbridgeTransaction {
  id                 String    @id @default(uuid())
  gatePassId         String    @unique
  gatePass           GatePass  @relation(fields: [gatePassId], references: [id])
  
  grossWeight        Float?    // in MT
  tareWeight         Float?    // in MT
  netWeight          Float?    // in MT
  
  grossTimestamp     DateTime?
  tareTimestamp      DateTime?
  
  manualOverrideFlag Boolean   @default(false)
  overrideReason     String?
  approvedByUserId   String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ProcurementBatch {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  
  gatePassId  String   @unique
  gatePass    GatePass @relation(fields: [gatePassId], references: [id])
  
  grossWeight Float    // in MT
  tareWeight  Float    // in MT
  netWeight   Float    // in MT
  status      String   @default("PENDING") // PENDING, QC_APPROVED, QC_REJECTED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Production, Yield & Inventory Management (Milestone 3)
// -----------------------------------------------------------------------------

enum MillingStatus {
  PENDING
  RUNNING
  COMPLETED
}

enum TransferStatus {
  INITIATED
  IN_TRANSIT
  RECEIVED
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum ItemCategory {
  RAW_MATERIAL
  FINISHED_GOOD
  CONSUMABLE
}

enum LossType {
  MOISTURE
  HANDLING
  CLEANING
}

model Batch {
  id              String         @id @default(uuid())
  batchNumber     String         @unique
  plantId         String
  plant           Plant          @relation(fields: [plantId], references: [id])
  rawMaterialQty  Float          // Total input in Metric Tons (MT)
  status          MillingStatus  @default(PENDING)
  millingProcess  MillingProcess?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MillingProcess {
  id              String         @id @default(uuid())
  batchId         String         @unique
  batch           Batch          @relation(fields: [batchId], references: [id])
  status          MillingStatus  @default(PENDING)
  startTime       DateTime?
  endTime         DateTime?
  productionLogs  ProductionLog[]
  processLosses   ProcessLoss[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductionLog {
  id               String         @id @default(uuid())
  millingProcessId String
  millingProcess   MillingProcess @relation(fields: [millingProcessId], references: [id])
  itemType         String          // e.g., HEAD_RICE, BROKEN_RICE, BRAN
  quantity         Float          // MT produced
  shift            String?        // Shift 1, Shift 2
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProcessLoss {
  id               String         @id @default(uuid())
  millingProcessId String
  millingProcess   MillingProcess @relation(fields: [millingProcessId], references: [id])
  lossType         LossType
  quantity         Float          // MT lost
  createdAt        DateTime       @default(now())
}

model InventoryItem {
  id           String         @id @default(uuid())
  plantId      String
  plant        Plant          @relation(fields: [plantId], references: [id])
  itemCategory ItemCategory
  itemType     String         // e.g., PADDY, HEAD_RICE, BROKEN_RICE, PACKAGING
  quantity     Float          // In MT or Units
  stockLedgers StockLedger[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([plantId, itemType])
  @@map("Inventory") // Keeps underlying data table aligned with previous milestones
}

model StockLedger {
  id              String          @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  transactionType TransactionType
  quantity        Float           // Positive for additions, negative for subtractions
  referenceId     String?         // ID of GatePass, Batch, or Transfer triggering this
  remarks         String?
  createdAt       DateTime        @default(now())
}

model PlantTransfer {
  id            String         @id @default(uuid())
  sourcePlantId String
  sourcePlant   Plant          @relation("SourceTransfers", fields: [sourcePlantId], references: [id])
  targetPlantId String
  targetPlant   Plant          @relation("TargetTransfers", fields: [targetPlantId], references: [id])
  itemType      String
  quantity      Float
  status        TransferStatus @default(INITIATED)
  initiatedBy   String
  receivedBy    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
