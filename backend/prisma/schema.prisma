generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Plant {
  id          String    @id @default(uuid())
  name        String
  location    String?
  code        String    @unique // e.g., 'PLANT-A'
  
  // Relations
  users        UserPlantAccess[]
  procurements ProcurementBatch[]
  inventories  Inventory[]
  suppliers    Supplier[]
  gatePasses   GatePass[]
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([code])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., 'SUPER_ADMIN', 'PLANT_MANAGER', 'WEIGHBRIDGE_OPERATOR', 'ACCOUNTANT'
  description String?
  
  // Relations
  users       User[]
  permissions RolePermission[]
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id          String    @id @default(uuid())
  action      String    @unique // e.g., 'read:plants', 'create:users'
  description String?
  
  // Relations
  roles       RolePermission[]

  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model RolePermission {
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  refreshToken String?
  
  // Relations
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  plantAccess  UserPlantAccess[]

  // Tracking
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([username])
  @@index([email])
  @@index([roleId])
}

model UserPlantAccess {
  userId  String
  plantId String
  
  user    User  @relation(fields: [userId], references: [id])
  plant   Plant @relation(fields: [plantId], references: [id])

  @@id([userId, plantId])
  @@index([userId])
  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Procurement & Inventory
// -----------------------------------------------------------------------------

model Supplier {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  
  plantId     String
  plant       Plant     @relation(fields: [plantId], references: [id])
  
  gatePasses  GatePass[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([plantId])
}

model GatePass {
  id              String    @id @default(uuid())
  passNumber      String    @unique // e.g., GP-YYYYMMDD-XXXX
  vehicleNumber   String
  driverName      String?
  driverLicense   String?
  source          String    // FARMER, MANDI, VENDOR
  
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  
  estimatedBags   Int?
  status          String    @default("GENERATED") // GENERATED, GROSS_WEIGHED, QC_PASSED, TARE_WEIGHED, COMPLETED, REJECTED
  
  plantId         String
  plant           Plant     @relation(fields: [plantId], references: [id])
  createdByUserId String
  
  qualityCheck    QualityCheck?
  weighbridge     WeighbridgeTransaction?
  procurement     ProcurementBatch?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([plantId])
}

model QualityCheck {
  id                      String    @id @default(uuid())
  gatePassId              String    @unique
  gatePass                GatePass  @relation(fields: [gatePassId], references: [id])
  
  moisturePercentage      Float
  discolorationPercentage Float
  brokenGrainsPercentage  Float
  foreignMatterPercentage Float
  
  status                  String    @default("PENDING") // APPROVED, REJECTED, ACCEPTED_WITH_DEDUCTION
  priceDeductionPerMT     Float     @default(0)
  
  inspectorId             String
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model WeighbridgeTransaction {
  id                 String    @id @default(uuid())
  gatePassId         String    @unique
  gatePass           GatePass  @relation(fields: [gatePassId], references: [id])
  
  grossWeight        Float?    // in MT
  tareWeight         Float?    // in MT
  netWeight          Float?    // in MT
  
  grossTimestamp     DateTime?
  tareTimestamp      DateTime?
  
  manualOverrideFlag Boolean   @default(false)
  overrideReason     String?
  approvedByUserId   String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ProcurementBatch {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  
  gatePassId  String   @unique
  gatePass    GatePass @relation(fields: [gatePassId], references: [id])
  
  grossWeight Float    // in MT
  tareWeight  Float    // in MT
  netWeight   Float    // in MT
  status      String   @default("PENDING") // PENDING, QC_APPROVED, QC_REJECTED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plantId])
}

model Inventory {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  itemType    String   // PADDY, HEAD_RICE, BROKEN_RICE, BRAN, HUSK
  quantity    Float    // in MT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([plantId, itemType])
}
