generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Plant {
  id          String    @id @default(uuid())
  name        String
  location    String?
  code        String    @unique // e.g., 'PLANT-A'
  
  // Relations
  users       UserPlantAccess[]
  procurements ProcurementBatch[]
  inventories  Inventory[]
  stockLedger  StockLedger[]
  productionLogs ProductionLog[]
  gatePasses   GatePass[]
  millingProcesses MillingProcess[]
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([code])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., 'SUPER_ADMIN', 'PLANT_MANAGER', 'WEIGHBRIDGE_OPERATOR', 'ACCOUNTANT'
  description String?
  
  // Relations
  users             User[]
  modulePermissions ModulePermission[]
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model ModulePermission {
  id          String    @id @default(uuid())
  roleId      String
  moduleName  String    // e.g., 'Dashboard', 'Procurement', 'Inventory'
  canView     Boolean   @default(false)
  canAdd      Boolean   @default(false)
  canEdit     Boolean   @default(false)
  canDelete   Boolean   @default(false)
  canApprove  Boolean   @default(false)
  
  role        Role      @relation(fields: [roleId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([roleId, moduleName])
  @@index([roleId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  refreshToken String?
  isActive     Boolean   @default(true) // Added for dynamic active/inactive toggles
  
  // Relations
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  plantAccess  UserPlantAccess[]
  auditLogs    SystemAuditLog[]

  // Tracking
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([username])
  @@index([email])
  @@index([roleId])
}

model UserPlantAccess {
  userId  String
  plantId String
  
  user    User  @relation(fields: [userId], references: [id])
  plant   Plant @relation(fields: [plantId], references: [id])

  @@id([userId, plantId])
  @@index([userId])
  @@index([plantId])
}

model SystemAuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String   // e.g., 'CREATED_USER', 'UPDATED_PERMISSIONS'
  module      String   // e.g., 'Users & Roles', 'Dashboard'
  details     String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Operations & Inventory
// -----------------------------------------------------------------------------

model ProcurementBatch {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  gatePassId  String   @unique
  grossWeight Float    // in MT
  tareWeight  Float    // in MT
  netWeight   Float    // in MT
  status      String   @default("PENDING") // PENDING, QC_APPROVED, QC_REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plantId])
}

model Inventory {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  itemType    String   // PADDY, HEAD_RICE, BROKEN_RICE, BRAN, HUSK
  quantity    Float    // in MT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([plantId, itemType])
}

model StockLedger {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  transaction String   // IN, OUT
  itemType    String   // PADDY, RICE, etc.
  quantity    Float    // in MT
  reference   String?  // e.g. batch id, dispatch id
  createdAt   DateTime @default(now())
  
  @@index([plantId])
  @@index([createdAt])
}

model ProductionLog {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  batchId     String
  itemType    String   // HEAD_RICE, BRAN, HUSK
  quantity    Float    // in MT
  createdAt   DateTime @default(now())
  
  @@index([plantId])
  @@index([createdAt])
}

model MillingProcess {
  id             String   @id @default(uuid())
  plantId        String
  plant          Plant    @relation(fields: [plantId], references: [id])
  batchId        String
  rawMaterialQty Float    // Input Paddy in MT
  outputQty      Float    // Output Rice in MT
  yieldPercent   Float
  createdAt      DateTime @default(now())
  
  @@index([plantId])
  @@index([createdAt])
}

model GatePass {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  passType    String   // INWARD, OUTWARD
  vehicleNo   String
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt   DateTime @default(now())
  
  @@index([plantId])
}
