generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Plant {
  id       String  @id @default(uuid())
  name     String
  location String?
  code     String  @unique // e.g., 'PLANT-A'

  // Settings
  standardBagWeight Float  @default(0.382)
  aClassBagWeight   Float  @default(0.380)
  bClassBagWeight   Float  @default(0.385)
  govtRate          Float? @default(0)
  benchmarkMoisture Float? @default(17.0)
  safaiCut          Float? @default(2.0)
  processingCut     Float? @default(4.0)
  /// Mill-wise chronological Boli No. sequence (Feedback 32)
  nextBoliSeq       Int    @default(1)
  /// Admin ON: supervisors may edit date/time manually on Paddy Inward
  allowManualDateTimePaddyInward Boolean @default(false)
  /// Admin ON: supervisors may edit date/time manually on Gate In
  allowManualDateTimeGateIn      Boolean @default(false)
  /// Admin ON: supervisors may edit date/time manually on Gate Out
  allowManualDateTimeGateOut     Boolean @default(false)
  /// Admin ON: supervisors may edit date/time + punch Gross/Tare manually on Stack↔Hoodi / Dryer Bharai transfers (Feedback 47)
  allowManualDateTimeStackTransfer Boolean @default(false)

  // Relations
  users                   UserPlantAccess[]
  procurements            ProcurementBatch[]
  suppliers               Supplier[]
  inventories             Inventory[]
  stockLedger             StockLedger[]
  productionBatches       ProductionBatch[]
  yieldReports            YieldReport[]
  gatePasses              GatePass[]
  intermillBatches        IntermillBatch[]
  duplicateGatePassLogs   DuplicateGatePassLog[]
  weighbridgeTransactions WeighbridgeTransaction[]
  weighbridgeSettings     WeighbridgeSettings?
  paddySodaPendings       PaddySodaPending[]
  mandiDailyRates         MandiDailyRate[]
  dispatches              Dispatch[]
  financeTransactions     FinanceTransaction[]
  expenseFunds            ExpenseFund[]
  expenseEntries          ExpenseEntry[]
  expenseTickets          ExpenseTicket[]
  financeSodaMills        FinanceSodaMill[]
  financeSodasAsParty     FinanceSoda[]        @relation("SodaPartyPlant")
  financeSalePurchaseLines FinanceSalePurchaseLine[]
  financeLedgerAsParty    FinanceLedgerEntry[] @relation("LedgerPartyPlant")
  financeLedgerMills      FinanceLedgerEntry[] @relation("LedgerMill")
  systemUtility           SystemUtility?
  plantDowntimes          PlantDowntime[]

  // Transfers
  transfersDispatched TransferTicket[] @relation("TransferDispatch")
  transfersReceived   TransferTicket[] @relation("TransferRecipient")

  // Power Management
  powerSources PowerSource[]
  powerReadings PowerReading[]
  powerLoads   PowerLoad[]
  powerAlerts  PowerAlert[]
  powerSetting PowerSetting?

  // Master Data & Permissions
  truckMasters        TruckMaster[]
  driverMasters       DriverMaster[]
  staffMasters        StaffMaster[]
  labourMasters       LabourMaster[]
  pahunchMasters      PahunchMaster[]
  permissionOverrides PermissionOverride[]
  stockHealthConfig   StockHealthConfig?
  consignmentDispatches ConsignmentDispatch[]
  paddyUsageRecords     PaddyUsageRecord[]
  dieselFuelEntries     DieselFuelEntry[]
  millYieldBenchmarks   MillYieldBenchmark[]

  // Tracking
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., 'SUPER_ADMIN', 'PLANT_MANAGER', 'WEIGHBRIDGE_OPERATOR', 'ACCOUNTANT'
  description String?

  // Relations
  users             User[]
  modulePermissions ModulePermission[]

  // Tracking
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ModulePermission {
  id            String  @id @default(uuid())
  roleId        String
  moduleName    String // e.g., 'Dashboard', 'Procurement', 'Inventory'
  subModuleName String  @default("")
  canView       Boolean @default(false)
  canAdd        Boolean @default(false)
  canEdit       Boolean @default(false)
  canDelete     Boolean @default(false)
  canApprove    Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleName, subModuleName])
  @@index([roleId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  refreshToken String?
  isActive     Boolean  @default(true) // Added for dynamic active/inactive toggles

  // Relations
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  plantAccess         UserPlantAccess[]
  auditLogs           SystemAuditLog[]
  permissionOverrides PermissionOverride[]
  intermillBatches    IntermillBatch[]     @relation("IntermillSupervisor")

  // Tracking
  lastLogin DateTime?
  /// Fingerprint PidData XML (RD capture) — supervisors enroll two fingers
  fingerprint1 String?
  fingerprint2 String?
  /// Matchable FMR/ISO template (base64) extracted at enroll — used for 1:1 verify
  fingerprint1Template String?
  fingerprint2Template String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([username])
  @@index([email])
  @@index([roleId])
}

model UserPlantAccess {
  userId  String
  plantId String

  user  User  @relation(fields: [userId], references: [id])
  plant Plant @relation(fields: [plantId], references: [id])

  @@id([userId, plantId])
  @@index([userId])
  @@index([plantId])
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // e.g., 'CREATED_USER', 'UPDATED_PERMISSIONS'
  module    String // e.g., 'Users & Roles', 'Dashboard'
  details   String?
  entityId  String?
  plantId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Supplier Master
// -----------------------------------------------------------------------------
model Supplier {
  id        String   @id @default(uuid())
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id])
  name      String
  firmNames String[]
  mandi     String?
  contact   String?
  email     String?
  address   String?
  /// ACTIVE | PENDING_APPROVAL — supervisor create needs Admin confirm
  status    String   @default("ACTIVE")
  /// Supervisor fingerprint at create (match logged-in user)
  biometricData String?
  createdById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  procurements      ProcurementBatch[]
  gatePasses        GatePass[]
  paddySodaPendings PaddySodaPending[]

  /// Mill-scoped Arthiya (same name allowed in other mills as separate rows)
  @@index([plantId])
  @@index([plantId, name])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Weighbridge Integration
// -----------------------------------------------------------------------------
model WeighbridgeSettings {
  id             String   @id @default(uuid())
  plantId        String   @unique
  plant          Plant    @relation(fields: [plantId], references: [id])
  indicatorModel String   @default("Essae - DS2520")
  connectionType String   @default("Serial Port (COM)")
  port           String   @default("COM4")
  baudRate       String   @default("2400")
  dataBits       String   @default("8")
  stopBits       String   @default("1")
  parity         String   @default("None")
  weightUnit     String   @default("Kilogram (kg)")
  autoCapture    Boolean  @default(true)
  autoSave       Boolean  @default(true)
  autoTare       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Operations & Inventory
// -----------------------------------------------------------------------------
enum InventoryCategory {
  OPERATIONAL
  NON_OPERATIONAL
}

enum PurchaseType {
  PADDY_BOLI
  PADDY_NORMAL
  NON_OPERATIONAL_ASSET
}

model ProcurementBatch {
  id            String                  @id @default(uuid())
  plantId       String
  plant         Plant                   @relation(fields: [plantId], references: [id])
  supplierId    String?
  supplier      Supplier?               @relation(fields: [supplierId], references: [id])
  gatePassId    String?                 @unique
  gatePass      GatePass?               @relation(fields: [gatePassId], references: [id])
  weighbridgeId String?                 @unique
  weighbridge   WeighbridgeTransaction? @relation(fields: [weighbridgeId], references: [id])
  biometricData String? // Store fingerprint XML/PID data

  grossWeight Float? // in MT
  tareWeight  Float? // in MT
  netWeight   Float? // in MT

  category     InventoryCategory? @default(OPERATIONAL)
  purchaseType PurchaseType?      @default(PADDY_NORMAL)

  baseRate          Float?
  finalRate         Float?
  arhtiaCorrection  Float?
  nextDayCorrection Float?
  isSettled         Boolean @default(false)

  amount     Float?
  deductions Float?
  netAmount  Float?

  paddyInwardDetails PaddyInwardDetails?

  status String @default("PENDING") // PENDING, QC_APPROVED, QC_REJECTED, COMPLETED

  quality QualityInspection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([supplierId])
}

model QualityInspection {
  id                 String           @id @default(uuid())
  procurementBatchId String           @unique
  procurementBatch   ProcurementBatch @relation(fields: [procurementBatchId], references: [id])
  moisture           Float?
  broken             Float?
  discoloration      Float?
  foreignMatter      Float?
  status             String           @default("PENDING") // APPROVED, REJECTED
  inspectedBy        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model PaddyInwardDetails {
  id                 String           @id @default(uuid())
  procurementBatchId String           @unique
  procurementBatch   ProcurementBatch @relation(fields: [procurementBatchId], references: [id])

  truckNo           String?
  gpNo              String?
  mandi             String?
  mandiEgNo         String?
  mandiParchiNo     String?
  rstNo             String?
  pahunchPersonName String?
  safaiType         String? // Good, Patal
  intimationToMandi Boolean? @default(false)
  mandiQualityAlert Boolean? @default(false)

  // Boli Mandi Fields
  mandiType     String? // Boli, Control
  boliRate      Float?
  boliChecklist Boolean? @default(false)
  bardanaClass  String? // A_Class, B_Class

  allocationType            String? // Hoodi, Stacking
  isUploadedToHoodiRegister Boolean?  @default(false)
  allocateUnloader          String?
  gaddiCount                Float?
  stackNo                   String?
  unloadingStartTime        DateTime?
  unloadingEndTime          DateTime?
  labourType                String? // Inside, Outside
  bagType                   String?   @default("NEW")

  originalBardanaClass String? // A_Class, B_Class
  agencyGpBardanaClass String? // A_Class, B_Class

  bagsRecAtMill   Float?
  bagsAtAgencyGp  Float?
  netWtAtMill     Float?
  requiredNetWt   Float?
  netWtDifference Float?
  netWtAtParty    Float?

  shortageType                String? // Received, Occurred, NA
  isUpdatedInShortageRegister Boolean? @default(false)
  balanceShortageArhtia       Float?

  bhariVideoUrl String?
  khaliVideoUrl String?

  shortageAClass Float?
  shortageBClass Float?

  qualityCutType   String? // BAGS, PERCENTAGE
  qualityCutValue  Float?
  qualityCutReason String?

  // Shortage Hisab Fields
  standardBagWeight        Float? // Snapshot of the weight used
  totalBagsCalculated      Float?
  standardWeightCalculated Float?
  actualWeightReceived     Float?
  shortageQtl              Float?
  shortageRecoveryQtl      Float?   @default(0)
  mandiSupervisorNotified  Boolean? @default(false)
  shortageBags             Float?

  // Bardana Hisab Fields
  aClassGiven           Float?
  aClassReceived        Float?
  aClassPending         Float?
  bClassGiven           Float?
  bClassReceived        Float?
  bClassPending         Float?
  autoConvertedToBClass Float?

  // NEW FIELDS FROM FORM IMAGE
  partyName                        String?
  moisture                         Float?
  paddyBoliRecord                  String?
  mainUnloaderTruckCount           Float?
  bagsInMainStack                  Float?
  secondPartStackNo                String?
  bagsInSecondPartStack            Float?
  /// Part unload destination is Hoodi (instead of another stack)
  partIsHoodi                      Boolean? @default(false)
  /// Unitary-split weights (quintals) for main / part unload points
  mainUnloadWeight                 Float?
  partUnloadWeight                 Float?
  unloaderName                     String?
  cutToBeAddedInShortage           Boolean?
  totalBagsReceived                Float?
  bagsRecLessThanAgencyGp          Boolean?
  plusWtConsiderInShortageRecovery Boolean?
  driverName                       String?
  driverMobileNumber               String?
  unloaderSignAndStamp             Boolean? @default(false)
  pahunchPersonSignAndStamp        Boolean? @default(false)
  govtRate                         Float?

  /// Feedback 33
  grossWeight                      Float?
  tareWeight                       Float?
  netWeightWb                      Float?
  qualityCutQtl                    Float?
  weightShortageQtl                Float?
  bagsLessShortageQtl              Float?
  shortageNarration                String?
  /// Feedback 34 — multi-type ledger entries (JSON array)
  shortageLedger                   Json?
  informBaujiBagsLess              Boolean? @default(false)
  informBaujiExcessWeight          Boolean? @default(false)
  partUnloaderName                 String?
  partUnloaderTruckCount           Float?
  meterNotWorking                  Boolean? @default(false)
  newTruckReading                  Float?
  /// Draft Time In / Confirm Time Out (HH:mm)
  timeIn                           String?
  timeOut                          String?
  entryDate                        String? // YYYY-MM-DD
  /// GP Complete Date (YYYY-MM-DD) — with Time Out below Shortage Management
  gpCompleteDate                   String?
  /// Entry Completion Date & Time (ISO) — separate from GP Complete; set on supervisor fingerprint at tare/confirm
  entryCompletionAt                String?
  /// Who submitted (fingerprint / confirm) — audit trail
  entryMadeByName                  String?
  entryMadeByUserId                String?
  /// True when recorded Date & Time In is before the day the entry was actually made
  isBackdated                      Boolean? @default(false)
  remarks                          String?
  discrepancy                      String?

  /// Feedback 39 — Hold under Unloading Management (Section 4)
  isHold                           Boolean  @default(false)
  holdReason                       String?
  heldAt                           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaddySodaPending {
  id         String   @id @default(uuid())
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  date          DateTime @default(now())
  moisture      Float?
  bags          Float?
  rate          Float?
  govtRate      Float?
  /// Snapshot of mandi bulletin Today Rate (Admin Mandi Daily Rate)
  todayRate     Float?
  /// Snapshot of M/C Point (₹ per 1% moisture) from Admin Mandi Daily Rate
  mcPoint       Float?
  diff          Float?
  payment       Float?
  note          String?
  finalHisabAmt Float?
  riceCategory  String?  @default("ANY")
  sodaCompleted Boolean? @default(false)

  /// Feedback 32 — estimate purchase authorship / update limits
  supervisorName     String?
  supervisorUserId   String?
  biometricData      String?
  dailyUpdateCount   Int       @default(0)
  lastUpdateDate     DateTime?
  cancelCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bolis      PaddyBoli[]
  gatePasses GatePass[]

  @@index([plantId])
  @@index([supplierId])
}

model PaddyBoli {
  id            String           @id @default(uuid())
  sodaPendingId String
  sodaPending   PaddySodaPending @relation(fields: [sodaPendingId], references: [id], onDelete: Cascade)

  /// Mill-wise chronological series shared by ALL lines of one Estimate Purchase / soda
  /// (e.g. BEAS-B0001). Next soda / day / Artia entry gets the next number.
  boliNo String?

  moisture Float
  /// Estimated bags from Add Estimate Purchase (0 = cancelled)
  bags     Float
  rate     Float
  /// Today Rate from Admin mandi bulletin at estimate time (for up/down vs Boli Rate)
  todayRate Float?
  /// Backend MC deduction: (currentMoisture − plant.benchmarkMoisture) × M/C Point
  /// e.g. (20 − 18) × 50 = 100. Null when M/C Point not set.
  mcDeduction Float?
  /// Base Boli Rate = Today Rate (Base Rate) − M/C Deduction; e.g. 2200 − 100 = 2100
  baseBoliRate Float?

  /// Feedback 32 — Final Boli
  finalBags          Float?
  artiaBillChecked   Boolean @default(false)
  payment            Float?  @default(0)

  bagsReceived Float   @default(0)
  isCompleted  Boolean @default(false)
  isCancelled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sodaPendingId])
  @@index([boliNo])
}

model WeighbridgeTransaction {
  id              String    @id @default(uuid())
  plantId         String
  plant           Plant     @relation(fields: [plantId], references: [id])
  vehicleNo       String
  transactionType String    @default("INWARD")
  driverName      String?
  materialType    String?
  supplierName    String?
  challanNo       String?
  remarks         String?
  grossWeight     Float?
  tareWeight      Float?
  netWeight       Float?
  grossTime       DateTime?
  tareTime        DateTime?
  status          String    @default("PENDING") // PENDING_TARE, COMPLETED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  procurementBatch ProcurementBatch?

  gatePassId String?
  gatePass   GatePass? @relation(fields: [gatePassId], references: [id])

  @@index([plantId])
  @@index([vehicleNo])
}

model GatePass {
  id          String    @id @default(uuid())
  plantId     String
  plant       Plant     @relation(fields: [plantId], references: [id])
  passType    String // INWARD, OUTWARD
  vehicleNo   String
  vehicleType String?
  purpose     String? // PADDY_DELIVERY, DISPATCH, etc.
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  material    String?
  driverName  String?
  contactNo   String?
  challanNo   String?
  noOfBags    Int?
  grossWeight Float?
  tareWeight  Float?
  netWeight   Float?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  qrCode      String?   @unique

  previousTruckReading Float?
  newTruckReading      Float?
  kmsDriven            Float?
  meterNotWorking      Boolean @default(false)
  // Supervisor Features: Quality Cut & Soda Linking
  qualityCutType       String? // 'BAGS' or 'PERCENTAGE'
  qualityCutValue      Float?
  qualityCutReason     String?
  sodaPendingId        String?
  sodaPending          PaddySodaPending? @relation(fields: [sodaPendingId], references: [id])

  emptyVideoTime  String?
  loadedVideoTime String?
  partyName       String?
  ntWtParty       Float?
  sodaNo          String?
  remarks         String?
  biometricData   String? // Store fingerprint XML/PID data
  gstNo           String?

  // Feedback 28 — Finance Soda / Bill / Bag Type on Gate Pass
  financeSodaId   String?
  financeSoda     FinanceSoda? @relation("FinanceSodaGatePasses", fields: [financeSodaId], references: [id])
  financeSodaNA   Boolean      @default(false) // explicit Not Applicable
  billNo          String?
  billNoNA        Boolean      @default(false)
  bagTypeGp       String? // PLASTIC | JUTE | NOT_APPLICABLE
  financeSalePurchaseLine FinanceSalePurchaseLine?
  // New Requirements Fields (Defaulted/Optional for zero data loss)
  rstNo                 String?
  gpStartDate           DateTime? @default(now())
  gpCompleteDate        DateTime?
  isCompleteDateNA      Boolean   @default(false)
  weighbridgeActive     Boolean   @default(false)
  completedBySupervisor String?
  mainBags              Int       @default(0)
  shortageBags          Int       @default(0)
  isDraft               Boolean   @default(true)

  // Transfer Entry Management
  isTransfer            Boolean   @default(false)
  deliveryAtId          String?
  gpSuffix              String?
  actualDispatchPlantId String?
  
  originalTransferTicket TransferTicket? @relation("OriginalGp")
  autoGpInTicket         TransferTicket? @relation("AutoGpIn")
  autoGpOutTicket        TransferTicket? @relation("AutoGpOut")
  consignmentDispatches  ConsignmentDispatch[]

  items                 GatePassItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  procurementBatch        ProcurementBatch?
  dispatch                Dispatch?
  weighbridgeTransactions WeighbridgeTransaction[]

  @@index([plantId])
  @@index([vehicleNo])
  @@index([status])
  @@index([financeSodaId])
}

model GatePassItem {
  id         String   @id @default(uuid())
  gatePassId String
  gatePass   GatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  itemName   String
  unit       String   // "Bags" or "Quintal"
  quantity   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gatePassId])
}

model DuplicateGatePassLog {
  id            String   @id @default(uuid())
  plantId       String
  plant         Plant    @relation(fields: [plantId], references: [id])
  vehicleNo     String
  attemptedType String // INWARD
  reason        String // "Vehicle already has an active INWARD pass"
  createdAt     DateTime @default(now())

  @@index([plantId])
  @@index([vehicleNo])
  @@index([createdAt])
}

model Inventory {
  id      String @id @default(uuid())
  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id])

  itemType String // e.g. PADDY, RICE, BRAN, HUSK, CONSUMABLES
  category String? // Operational, Non-Operational
  variety  String? // IR-64, Swarna, MTU-7029, or Product name
  godown   String? // Godown A, Godown B

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity Float // Total Stock in selected unit
  usable   Float @default(0)
  reserved Float @default(0)
  damaged  Float @default(0)

  unit       String @default("MT")
  stockValue Float  @default(0) // Total value in ₹

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, itemType, variety, godown])
  @@index([productId])
}

model StockLedger {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  transaction String // IN, OUT, TRANSFER, ADJUSTMENT
  itemType    String // PADDY, RICE, etc.
  quantity    Float // in MT
  shift       String? // Day, Night
  reference   String? // e.g. batch id, dispatch id, transfer id
  remarks     String?
  createdAt   DateTime @default(now())

  @@index([plantId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Production & Yield
// -----------------------------------------------------------------------------
model ProductionBatch {
  id             String   @id @default(uuid())
  plantId        String
  plant          Plant    @relation(fields: [plantId], references: [id])
  productionState String   @default("RICE_MILLING") // PADDY_DRYING, RICE_MILLING, INTERMILL_PROCESSING, PLANT_OFF
  batchNo        String   @unique
  date           DateTime
  shift          String // Day, Night
  productionLine String
  paddyType      String
  variety        String
  paddySource    String?
  supervisorName String?
  analysisSheetNo String?
  elevatorVapsiCheck Boolean @default(false)
  paettiVapsiCheck   Boolean @default(false)

  paddyUsedQty    Float // in MT
  riceProducedQty Float? // in MT
  moisture        Float? // %

  // Additional Outputs (Produced)
  rBranBags        Int @default(0)
  kPhuckBags       Int @default(0)
  brokenRiceBags   Int @default(0)
  nakku1Bags       Int @default(0)
  nakku2Bags       Int @default(0)
  rejectionBags    Int @default(0)
  finalRiceBags    Int @default(0)
  mansooriBags     Int @default(0)
  wandProducedBags Int @default(0)
  wandBags         Int @default(0)
  parmalBags       Int @default(0)
  frkBags          Int @default(0)

  // Additional Outputs (Reused)
  rBranReused       Int @default(0)
  kPhuckReused      Int @default(0)
  brokenRiceReused  Int @default(0)
  nakku1Reused      Int @default(0)
  nakku2Reused      Int @default(0)
  rejectionReused   Int @default(0)
  finalRiceReused   Int @default(0)
  mansooriReused    Int @default(0)
  wandReused        Int @default(0)
  parmalReused      Int @default(0)
  frkReused         Int @default(0)

  status   String  @default("In Progress") // In Progress, Completed
  progress Int     @default(0) // 0-100%
  remarks  String?
  biometricData String? // Store fingerprint XML/PID data

  processLoss            ProcessLoss?
  byProducts             ByProduct[]
  paddyDryingTargetStack String?
  stackInputs            ProductionBatchStackInput[]
  yieldReport            YieldReport?
  batchAnalysis          BatchAnalysis[]

  startTime                DateTime? @default(now())
  endTime                  DateTime?
  finalOutputBiometricData String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([batchNo])
}

model ProcessLoss {
  id                String          @id @default(uuid())
  productionBatchId String          @unique
  batch             ProductionBatch @relation(fields: [productionBatchId], references: [id])

  cleaningLoss  Float @default(0) // in MT
  dryingLoss    Float @default(0)
  huskingLoss   Float @default(0)
  polishingLoss Float @default(0)
  brokenLoss    Float @default(0)

  totalLoss Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ByProduct {
  id                String          @id @default(uuid())
  productionBatchId String
  batch             ProductionBatch @relation(fields: [productionBatchId], references: [id])

  name        String // Bran, Rice Husk, Broken Rice, Rice Germ
  quantity    Float // in MT
  unit        String  @default("MT")
  utilization String? // Destination/Usage
  remarks     String?
  moisture    Float?
  targetStack String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionBatchId])
}

model YieldReport {
  id                String          @id @default(uuid())
  productionBatchId String          @unique
  batch             ProductionBatch @relation(fields: [productionBatchId], references: [id])
  plantId           String

  headRicePercent   Float
  brokenRicePercent Float
  branPercent       Float
  huskPercent       Float
  lossPercent       Float

  overallRecovery Float
  yieldTarget     Float?
  targetAchieved  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plant     Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId])
}

// -----------------------------------------------------------------------------
// Inter-Plant Transfer
// -----------------------------------------------------------------------------
model InterPlantTransfer {
  id        String @id @default(uuid())
  requestNo String @unique

  fromPlantId String
  toPlantId   String

  date     DateTime @default(now())
  item     String
  variety  String?
  quantity Float // in MT

  estimatedValue   Float?
  expectedDelivery DateTime?

  vehicleNo  String?
  driverName String?
  remarks    String?

  status String @default("Approved") // Approved, In Transit, Delivered, Cancelled

  dispatchedOn DateTime?
  receivedOn   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromPlantId])
  @@index([toPlantId])
  @@index([requestNo])
}

model QuantityUnit {
  id          String   @id @default(uuid())
  code        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String            @id @default(uuid())
  name              String            @unique
  type              String            @default("GENERAL")
  category          String            @default("OPERATIONAL")
  quantityFormat    String            @default("QTL")
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  inventories       Inventory[]
  intermillAsRaw    IntermillBatch[]  @relation("IntermillRawMaterial")
  intermillAsOutput IntermillOutput[] @relation("IntermillOutputProduct")
  financeSodas      FinanceSoda[]
}

// -----------------------------------------------------------------------------
// Dispatch Management
// -----------------------------------------------------------------------------
model Dispatch {
  id         String   @id @default(uuid())
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id])
  dispatchNo String   @unique
  date       DateTime @default(now())
  partyName  String
  item       String
  quantity   Float // in MT
  status     String   @default("Pending") // Pending, In Transit, Completed
  vehicleNo  String?

  gatePassId String?   @unique
  gatePass   GatePass? @relation(fields: [gatePassId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([dispatchNo])
}

// -----------------------------------------------------------------------------
// Finance Management — Feedback 28 Soda / Deals
// -----------------------------------------------------------------------------
model FinanceParty {
  id         String   @id @default(uuid())
  name       String
  contact    String?
  firmName   String?
  notes      String?
  /// Party type flags — at least one must be true (Customer / Supplier / Both)
  isCustomer Boolean  @default(true)
  isSupplier Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sodas    FinanceSoda[]
  ledger   FinanceLedgerEntry[]
  expenses ExpenseEntry[]
  dieselEntries DieselFuelEntry[]

  @@unique([name])
  @@index([name])
  @@index([isActive, isCustomer])
  @@index([isActive, isSupplier])
}

model FinanceSoda {
  id            String   @id @default(uuid())
  sodaType      String // SALE | PURCHASE
  sodaNumber    Int
  date          DateTime
  itemId        String
  item          Product  @relation(fields: [itemId], references: [id])
  partyId       String?
  party         FinanceParty? @relation(fields: [partyId], references: [id])
  partyPlantId  String?
  partyPlant    Plant?   @relation("SodaPartyPlant", fields: [partyPlantId], references: [id])
  rate          Float?
  isShift       Boolean  @default(false)
  quantity      Int // truck/count quota
  note          String?
  paymentStatus String   @default("NOT_CLEAR") // CLEAR | UNDERWAY | NOT_CLEAR
  paymentAmount Float    @default(0) // F29 will sync; stub for Section K
  mirrorSodaId  String?  @unique
  mirrorSoda    FinanceSoda? @relation("SodaMirror", fields: [mirrorSodaId], references: [id])
  mirroredFrom  FinanceSoda? @relation("SodaMirror")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mills      FinanceSodaMill[]
  gatePasses GatePass[] @relation("FinanceSodaGatePasses")
  salePurchaseLines FinanceSalePurchaseLine[]
  paymentStatusAudits FinancePaymentStatusAudit[]
  ledgerEntries FinanceLedgerEntry[]

  @@unique([sodaType, sodaNumber])
  @@index([sodaType])
  @@index([date])
  @@index([itemId])
}

model FinanceSodaMill {
  id     String @id @default(uuid())
  sodaId String
  soda   FinanceSoda @relation(fields: [sodaId], references: [id], onDelete: Cascade)
  plantId String
  plant   Plant @relation(fields: [plantId], references: [id])

  @@unique([sodaId, plantId])
  @@index([plantId])
}

// Feedback 29 — Sale / Purchase Report line (one per submitted non-draft GP)
model FinanceSalePurchaseLine {
  id          String   @id @default(uuid())
  reportType  String // SALE | PURCHASE
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  financeSodaId String
  financeSoda FinanceSoda @relation(fields: [financeSodaId], references: [id])
  gatePassId  String   @unique
  gatePass    GatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  /// Section H — chronological serial within parent soda (cross-mill)
  serialNo Int

  /// Section N — Yes/No bag tare consideration (default No)
  bagWeightConsideration Boolean @default(false)
  /// Section O — oil result % (Rice Bran)
  oilResult Float?
  /// Section X — cash discount %
  cdPercent Float @default(0)
  /// Section AA
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntry FinanceLedgerEntry?

  @@unique([financeSodaId, serialNo])
  @@index([plantId, reportType])
  @@index([financeSodaId])
}

model FinancePaymentStatusAudit {
  id            String   @id @default(uuid())
  financeSodaId String
  financeSoda   FinanceSoda @relation(fields: [financeSodaId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  changedById   String?
  createdAt     DateTime @default(now())

  @@index([financeSodaId])
}

// -----------------------------------------------------------------------------
// Finance Management — Party Ledger (Feedback 31)
// SALE → Debit (receivable) | PURCHASE → Credit (payable)
// RECEIPT (Payment Received) → Credit | PAYMENT (Payment Paid) → Debit
// -----------------------------------------------------------------------------
model FinanceLedgerEntry {
  id                 String   @id @default(uuid())
  date               DateTime
  entryType          String // SALE | PURCHASE | RECEIPT | PAYMENT
  partyId            String?
  party              FinanceParty? @relation(fields: [partyId], references: [id])
  partyPlantId       String?
  partyPlant         Plant?   @relation("LedgerPartyPlant", fields: [partyPlantId], references: [id])
  financeSodaId      String?
  financeSoda        FinanceSoda? @relation(fields: [financeSodaId], references: [id])
  salePurchaseLineId String?  @unique
  salePurchaseLine   FinanceSalePurchaseLine? @relation(fields: [salePurchaseLineId], references: [id], onDelete: Cascade)
  plantId            String?
  plant              Plant?   @relation("LedgerMill", fields: [plantId], references: [id])
  narration          String?
  notes              String?
  debit              Float    @default(0)
  credit             Float    @default(0)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([partyId, date])
  @@index([partyPlantId, date])
  @@index([entryType])
  @@index([financeSodaId])
  @@index([date])
}

// Legacy generic ledger (Milestone 4 / Dispatch) — kept for older flows
model FinanceTransaction {
  id              String   @id @default(uuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id])
  transactionType String // PURCHASE, SALE, PAYMENT, RECEIPT, EXPENSE, CONTRA, JOURNAL
  invoiceNo       String?  @unique // PUR250522001, etc.
  partyName       String?
  particulars     String? // Paddy Purchase, etc.
  category        String? // For Expenses: Transport, Labour, Electricity

  totalAmount Float
  paidAmount  Float    @default(0)
  balance     Float    @default(0)

  paymentStatus String   @default("UNPAID") // PAID, PARTIAL, UNPAID
  date          DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([transactionType])
  @@index([paymentStatus])
}

// -----------------------------------------------------------------------------
// Expenses — Petty Cash Book & Add Funds
// -----------------------------------------------------------------------------
/// Admin Add Funds entries (multiple per day / backdates allowed for Admin)
model ExpenseFund {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  date        DateTime
  amount      Float
  /// "To" — who received / where funds were given (manual)
  toName      String
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plantId, date])
}

/// Supervisor / mill Expense entries against petty cash
model ExpenseEntry {
  id                     String   @id @default(uuid())
  plantId                String
  plant                  Plant    @relation(fields: [plantId], references: [id])
  date                   DateTime
  partyId                String?
  party                  FinanceParty? @relation(fields: [partyId], references: [id])
  partyName              String?
  partyNotApplicable     Boolean  @default(false)
  itemsBought            String? // Items Bought / Service Availed
  itemsNotApplicable     Boolean  @default(false)
  amount                 Float
  gpNo                   String?
  gpNotApplicable        Boolean  @default(false)
  workOrderNo            String?
  workOrderNotApplicable Boolean  @default(false)
  biometricData          String?
  /// Display name of submitter (Petty Cash "By" column)
  submittedByName        String?
  /// Legacy / optional notes
  notes                  String?
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([plantId, date])
  @@index([partyId])
}

/// Admin clarification tickets on Petty Cash / Expense entries
model ExpenseTicket {
  id             String    @id @default(uuid())
  ticketNo       Int
  plantId        String
  plant          Plant     @relation(fields: [plantId], references: [id])
  /// Calendar day the ticket relates to
  date           DateTime
  expenseEntryId String?
  expenseFundId  String?
  section        String    @default("Expense") // Expense | Add Funds | Petty Cashbook
  raisedToUserId String?
  raisedToName   String?
  status         String    @default("OPEN") // OPEN | OK | CLOSED
  note           String?
  createdById    String?
  createdByName  String?
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([plantId, ticketNo])
  @@index([plantId, date])
  @@index([status])
}

// -----------------------------------------------------------------------------
// System Utility
// -----------------------------------------------------------------------------
model SystemUtility {
  id           String   @id @default(uuid())
  plantId      String   @unique
  plant        Plant    @relation(fields: [plantId], references: [id])
  powerStatus  String   @default("Normal") // Normal, On Backup, Offline
  lastBackup   DateTime @default(now())
  databaseSize Float    @default(0) // in GB
  systemUptime String   @default("15 Days")

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Power Management Module
// -----------------------------------------------------------------------------
model PowerSource {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  sourceName  String
  description String?
  type        String   @default("Diesel Generator") // Diesel Generator, Grid Power, Solar Power
  status      String   @default("Standby") // Running, Standby, Active, Inactive

  currentOutput Float   @default(0) // kW
  runtime       String? // e.g., "06h 30m"
  fuelLevel     Float? // percentage, null for grid/solar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model PowerReading {
  id               String   @id @default(uuid())
  plantId          String
  plant            Plant    @relation(fields: [plantId], references: [id])
  timestamp        DateTime @default(now())
  totalConsumption Float    @default(0) // kWh
  dgGenerated      Float    @default(0) // kWh
  gridUsed         Float    @default(0) // kWh
  costToday        Float    @default(0) // INR
  outageMinutes    Int      @default(0) // Outage time today in minutes

  currentLoad   Float @default(0) // kW
  totalCapacity Float @default(1000) // kW
  voltageAvg    Float @default(415) // V
  frequencyAvg  Float @default(50.02) // Hz
  powerFactor   Float @default(0.92)

  @@index([plantId])
  @@index([timestamp])
}

model PowerLoad {
  id          String @id @default(uuid())
  plantId     String
  plant       Plant  @relation(fields: [plantId], references: [id])
  sectionName String
  loadValue   Float  @default(0) // kW
  percentage  Float  @default(0)
  colorHex    String @default("#3b82f6")

  @@index([plantId])
}

model PowerAlert {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  title       String
  description String?
  type        String   @default("info") // success, warning, error, info
  timestamp   DateTime @default(now())

  @@index([plantId])
  @@index([timestamp])
}

model PowerSetting {
  id                 String  @id @default(uuid())
  plantId            String  @unique
  plant              Plant   @relation(fields: [plantId], references: [id])
  highLoadWarning    Int     @default(85) // Percentage
  criticalLoadAlert  Int     @default(95) // Percentage
  autoStartGenerator Boolean @default(true)
  gridPowerRate      Float   @default(8.50) // Per kWh
  dieselCost         Float   @default(92.40) // Per Litre

  updatedAt DateTime @updatedAt
}

// ==========================================
// MASTER DATA MODELS
// ==========================================
model TruckMaster {
  id                String   @id @default(uuid())
  plantId           String
  plant             Plant    @relation(fields: [plantId], references: [id])
  /// Vehicle number OR manual name (for Generator)
  truckNumber       String   @unique
  capacity          Float? // Optional capacity in MT
  imageUrl          String? // Optional Cloudinary image URL
  isApproved        Boolean  @default(false)
  transportCategory String   @default("PARTY") // COMPANY, PARTY, OTHER
  /// 06W | 10W | 12W | 14W | TRACTOR | GENERATOR | CAR | BIKE
  vehicleType       String   @default("10W")
  /// KM | HRS — reading unit for diesel averages
  readingUnit       String   @default("KM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dieselEntries DieselFuelEntry[]

  @@index([plantId])
  @@index([vehicleType])
}

model DriverMaster {
  id        String   @id @default(uuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  licenseNo String?
  phone     String?
  age       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dieselEntries DieselFuelEntry[]

  @@index([plantId])
}

model StaffMaster {
  id           String   @id @default(uuid())
  plantId      String
  plant        Plant    @relation(fields: [plantId], references: [id])
  name         String
  role         String // e.g. "PAHUNCH", "UNLOADER"
  phone        String?
  fingerprint1 String? // Required for UNLOADER registration
  fingerprint2 String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dieselAsDriver DieselFuelEntry[] @relation("DieselDriverStaff")

  @@index([plantId])
}

/// Feedback 27 — Truck diesel / refueling entries (any mill)
model DieselFuelEntry {
  id              String   @id @default(uuid())
  date            DateTime
  truckId         String
  truck           TruckMaster @relation(fields: [truckId], references: [id])
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id])
  slipNo          Int
  truckType       String // snapshot from truck master
  readingUnit     String // KM | HRS
  oldReading      Float    @default(0)
  oldAverage      Float    @default(0)
  newReading      Float
  dieselQty       Float // liters
  totalRun        Float // new - old
  average         Float // totalRun / dieselQty
  rate            Float
  amount          Float // dieselQty * rate
  partyId         String?
  party           FinanceParty? @relation(fields: [partyId], references: [id])
  partyName       String?
  driverStaffId   String?
  driverStaff     StaffMaster? @relation("DieselDriverStaff", fields: [driverStaffId], references: [id])
  driverMasterId  String?
  driverMaster    DriverMaster? @relation(fields: [driverMasterId], references: [id])
  driverName      String?
  biometricData   String?
  submittedByName String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([truckId, date])
  @@index([plantId, date])
  @@index([partyId])
  @@index([slipNo])
}

// ==========================================
// PERMISSIONS OVERRIDE (8-Hour Auto Cutoff)
// ==========================================
model PermissionOverride {
  id             String   @id @default(uuid())
  plantId        String
  plant          Plant    @relation(fields: [plantId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  permissionType String // "BACKDATE_ENTRY", "MANUAL_WEIGHBRIDGE"
  grantedBy      String // ID of the Admin who granted it
  createdAt      DateTime @default(now())
  expiresAt      DateTime // Set to createdAt + 8 hours
  isActive       Boolean  @default(true) // Admin can toggle off early

  @@index([plantId, userId])
  @@index([expiresAt])
}

model LabourMaster {
  id        String   @id @default(uuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  firmName  String?
  contact   String?
  type      String? // e.g. Inside, Outside, General
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model PahunchMaster {
  id        String   @id @default(uuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Mandi {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Admin-maintained daily mandi bulletin: Today Rate + M/C Point (Boli Record Admin section)
model MandiDailyRate {
  id        String   @id @default(uuid())
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id])
  date      DateTime
  mandi     String
  todayRate Float
  /// M/C Point: ₹ monetary impact per 1% moisture (e.g. base 2200, M/C Point 50)
  mcPoint   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, date, mandi])
  @@index([plantId, date])
  @@index([mandi])
}

model IntermillBatch {
  id            String            @id @default(uuid())
  batchNo       String            @unique
  shift         String
  supervisorId  String
  supervisor    User              @relation("IntermillSupervisor", fields: [supervisorId], references: [id])
  date          DateTime
  startTime     String
  endTime       String
  rawMaterialId String
