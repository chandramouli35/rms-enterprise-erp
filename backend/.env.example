# PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT (required in production)
JWT_SECRET="change-me-to-a-long-random-string"

# Server
PORT=3000

# Weighbridge COM Bridge (optional). If set, Bridge must send header X-Bridge-Key.
# WEIGHBRIDGE_BRIDGE_SECRET=change-me-bridge-secret

# Cloudinary (optional — truck / media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
